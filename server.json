{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nexdocai/nexdoc-design-mcp",
  "title": "NexDoc Design",
  "description": "Generate, update, export, and publish production-ready designs with NexDoc Design.",
  "websiteUrl": "https://www.nexdoc.design",
  "repository": {
    "url": "https://github.com/nexdocai/nexdoc-design-mcp",
    "source": "github"
  },
  "version": "0.3.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.nexdoc.design/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@nexdoc/mcp-server",
      "version": "0.3.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NXD_API_KEY",
          "description": "NexDoc API key (nxd_live_...). Prefer the hosted OAuth endpoint for remote clients.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "NXD_API_URL",
          "description": "NexDoc Design API base URL",
          "isRequired": false,
          "default": "https://api.nexdoc.design"
        }
      ]
    }
  ]
}
